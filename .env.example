# Solana B2B Invoicing Platform - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================

# Solana RPC Endpoint
# Localnet: http://127.0.0.1:8899
# Devnet: https://api.devnet.solana.com
# Mainnet: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=http://127.0.0.1:8899

# Solana Wallet Path (for CLI scripts)
# Default: ~/.config/solana/id.json
WALLET_PATH=~/.config/solana/id.json

# =============================================================================
# NOTES
# =============================================================================
# 1. For localnet development, use http://127.0.0.1:8899
# 2. For devnet testing, use https://api.devnet.solana.com
# 3. For mainnet, use a premium RPC provider (Helius, QuickNode, etc.)
# 4. Never commit your .env file or wallet keys to version control
# 5. Use different wallet paths for different environments
